          },
          "expr": "sli:http_latency_p99:rate5m",
          "instant": false,
          "legendFormat": "p99",
          "range": true,
          "refId": "S"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"devops-app\"}[5m])))",
