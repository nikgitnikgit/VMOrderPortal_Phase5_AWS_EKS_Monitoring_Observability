          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{namespace=~\"devops-app|jenkins|observability\"}",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "E"
        }
      ],
      "title": "Targets",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
